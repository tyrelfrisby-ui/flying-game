{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flyinggame-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": false },
  // The multiplayer platform's home (owner 2026-10-11): mp.aeroplayground.app. The apex is the website (another worker).
  "routes": [{ "pattern": "mp.aeroplayground.app", "custom_domain": true }],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
