<!--
  IL2CPP managed-stripping guard. AircraftConfig / ChallengeDefinition and their nested config types
  are populated by Newtonsoft.Json via reflection, so their properties/setters can look "unused" to the
  stripper and get removed — deserialization then silently drops fields (or throws) on device only.
  Preserve the data assemblies and Newtonsoft so the same config JSON decodes identically to the editor.
-->
<linker>
  <assembly fullname="FlyingGame.Core" preserve="all"/>
  <assembly fullname="FlyingGame.Sim" preserve="all"/>
  <assembly fullname="Newtonsoft.Json" preserve="all"/>
  <!-- IMGUI (OnGUI HUD + touch controls) and text rendering: keep the module code so the default
       skin/font path isn't stripped (symptom: GUI.DoSetSkin NRE every frame, no GUI text on device). -->
  <assembly fullname="UnityEngine.IMGUIModule" preserve="all"/>
  <assembly fullname="UnityEngine.TextRenderingModule" preserve="all"/>
</linker>
